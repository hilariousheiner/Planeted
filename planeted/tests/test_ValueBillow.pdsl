import "../lib/stdlib.pdsl" 

n = billow(valueNoise("Amphitrite-29"));

n = setNormalizeFBM(n, false);
n = setStartFrequency(n, 1.0);
n = setLacunarity(n, 1.0);
n = setNumberOfOctaves(n, 6);
n = setExponent(n, 1.5);

noiseTest(n, "test_ValueBillow3D");
noiseTest2D(n, "test_ValueBillow2D");
noiseTest1D(n, "test_ValueBillow1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m); 
return displace(m, n, 0.25);