import "../lib/stdlib.pdsl" 

n = setWhiteNoiseScale(whiteNoise("Diomedes-1437"), 3.0);
n1 = setWhiteNoiseScale(whiteNoise1("Diomedes-1437"), 3.0);

noiseTest(n, "test_WhiteNoise3_3D");
noiseTest2D(n, "test_WhiteNoise3_2D");
savePGM(n1, "test_WhiteNoise3_1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);