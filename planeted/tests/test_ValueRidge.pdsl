import "../lib/stdlib.pdsl" 

fbmParams = fbmParameters();
fbmParams = setNumberOfOctaves(fbmParams, 6);
fbmParams = setLacunarity(fbmParams, 2.0);
fbmParams = setPersistence(fbmParams, 0.5);
fbmParams = setStartFrequency(fbmParams, 4.0);
fbmParams = setNormalizeFBM(fbmParams, false);

n = pow(abs(fbm(ridge(valueNoise("BETTY")), fbmParams)), 10.0);
n1 = pow(abs(fbm(ridge(valueNoise1("BETTY")), fbmParams)), 10.0);

noiseTest(n, "test_ValueRidge3D");
noiseTest2D(n, "test_ValueRidge2D");
savePGM(n1, "test_ValueRidge1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.05);