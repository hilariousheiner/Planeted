import "../lib/stdlib.pdsl" 

n = noise();

n = seedNoise(n, "BETTY");

n = setNormalizeFBM(n, false);
n = setStartFrequency(n, 4.0);
n = setNumberOfOctaves(n, 6);
n = setExponent(n, 10.0);

n = setNoiseType(n, NOISE_TYPE_VALUE);
n = setNoiseStyle(n, NOISE_STYLE_RIDGE);

noiseTest(n, "test_ValueRidge3D");
noiseTest2D(n, "test_ValueRidge2D");
noiseTest1D(n, "test_ValueRidge1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.05);