import "../lib/stdlib.pdsl" 

fbmParams = fbmParameters();
fbmParams = setNumberOfOctaves(fbmParams, 6);
fbmParams = setLacunarity(fbmParams, 1.0); 
fbmParams = setPersistence(fbmParams, 0.5);
fbmParams = setStartFrequency(fbmParams, 1.0);
fbmParams = setNormalizeFBM(fbmParams, false);

n1 = pow(abs(fbm(abs(perlinNoise1("Amphitrite-29")), fbmParams)), 1.5);
n2 = pow(abs(fbm(abs(perlinNoise2("Amphitrite-29")), fbmParams)), 1.5);
n3 = pow(abs(fbm(abs(perlinNoise3("Amphitrite-29")), fbmParams)), 1.5);

savePGM(n1, "test_PerlinBillow1D");
savePGM(n2, "test_PerlinBillow2D");
savePGM(n3, "test_PerlinBillow3D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n3, 0.25);