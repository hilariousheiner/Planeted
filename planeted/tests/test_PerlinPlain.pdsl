import "../lib/stdlib.pdsl" 

n = noise();

n = seedNoise(n, "11836-Eileen");

n = setNormalizeFBM(n, true);
n = setStartFrequency(n, 1.0);
n = setLacunarity(n, 2.0);
n = setNumberOfOctaves(n, 6);
n = setExponent(n, 1.0);

n = setNoiseType(n, NOISE_TYPE_PERLIN);
n = setNoiseStyle(n, NOISE_STYLE_PLAIN);

noiseTest(n, "test_PerlinPlain3D");
noiseTest2D(n, "test_PerlinPlain2D");
noiseTest1D(n, "test_PerlinPlain1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);