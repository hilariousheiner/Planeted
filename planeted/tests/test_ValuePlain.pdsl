import "../lib/stdlib.pdsl" 

fbmParams = fbmParameters();
fbmParams = setNumberOfOctaves(fbmParams, 6);
fbmParams = setLacunarity(fbmParams, 1.5);
fbmParams = setPersistence(fbmParams, 0.5);
fbmParams = setStartFrequency(fbmParams, 1.0);
fbmParams = setNormalizeFBM(fbmParams, false);

n = pow(abs(fbm(valueNoise("11836-Eileen"), fbmParams)), 2.0);

noiseTest(n, "test_ValuePlain3D");
noiseTest2D(n, "test_ValuePlain2D");
noiseTest1D(n, "test_ValuePlain1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 1.0);