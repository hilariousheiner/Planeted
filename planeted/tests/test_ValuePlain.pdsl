import "../lib/stdlib.pdsl" 

n = valueNoise("11836-Eileen"); 

n = setNormalizeFBM(n, false);
n = setStartFrequency(n, 1.0);
n = setLacunarity(n, 1.5);
n = setNumberOfOctaves(n, 6);
n = setExponent(n, 2.0);

noiseTest(n, "test_ValuePlain3D");
noiseTest2D(n, "test_ValuePlain2D");
noiseTest1D(n, "test_ValuePlain1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 1.0);