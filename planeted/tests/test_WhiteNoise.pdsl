import "../lib/stdlib.pdsl" 

n1 = setWhiteNoiseScale(whiteNoise1("Diomedes-1437"), 100.0);
n2 = setWhiteNoiseScale(whiteNoise2("Diomedes-1437"), 100.0); 
n3 = setWhiteNoiseScale(whiteNoise3("Diomedes-1437"), 100.0); 

savePGM(n1, "test_WhiteNoise1D");
savePGM(n2, "test_WhiteNoise2D");
savePGM(n3, "test_WhiteNoise3D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n3, 0.25);