import "../lib/stdlib.pdsl" 

n = noise();

n = seedNoise(n, "Diomedes-1437");

n = setNormalizeFBM(n, false);
n = setStartFrequency(n, 1.0);
n = setLacunarity(n, 1.0);
n = setNumberOfOctaves(n, 1);
n = setExponent(n, 1.0);

n = setWhiteNoiseScale(n, 100.0);

n = setNoiseType(n, NOISE_TYPE_WHITE);
n = setNoiseStyle(n, NOISE_STYLE_PLAIN);

noiseTest(n, "test_WhiteNoise3D");
noiseTest2D(n, "test_WhiteNoise2D");
noiseTest1D(n, "test_WhiteNoise1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);