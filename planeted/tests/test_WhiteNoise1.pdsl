import "../lib/stdlib.pdsl" 

n = whiteNoise("Diomedes-1437");
n = setWhiteNoiseScale(n, 1.0);

noiseTest(n, "test_WhiteNoise1_3D");
noiseTest2D(n, "test_WhiteNoise1_2D");
noiseTest1D(n, "test_WhiteNoise1_1D");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);
return displace(m, n, 0.25);