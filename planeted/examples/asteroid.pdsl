import "../lib/stdlib.pdsl" 

n1 = valueNoise("CLOUD");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);

fbmParams = fbmParameters();
fbmParams = setNormalizeFBM(fbmParams, true);
fbmParams = setNumberOfOctaves(fbmParams, 8);
fbmParams = setLacunarity(fbmParams, 1.0);

n1 = fbm(n1, fbmParams);
n1 = pow(abs(n1), 1.0);

m = displace(m, n1, 0.5);
m = calculateNormals(m);

n2 = ridge(perlinNoise("BETTY"));

fbmParams2 = fbmParameters();
fbmParams2 = setNumberOfOctaves(fbmParams2, 2);
fbmParams2 = setStartFrequency(fbmParams2, 4);
fbmParams2 = setNormalizeFBM(fbmParams2, true);

n2 = fbm(n2, fbmParams2);
n2 = pow(abs(n2), 5.0);

m = displace(m, n2, 0.5);
m = calculateNormals(m);

n3 = whiteNoise();
n3 = setWhiteNoiseScale(n3, 1.0);

fbmParams3 = fbmParameters();
fbmParams3 = setNumberOfOctaves(fbmParams3, 1);

m = displace(m, fbm(n3, fbmParams3), 0.25);

return m;