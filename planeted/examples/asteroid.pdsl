import "../lib/stdlib.pdsl" 

n1 = noise();

n1 = seedNoise(n1, "CLOUD");

m = load("../lib/icosphere2.pdsl");
m = calculateNormals(m);

n1 = setNoiseType(n1, NOISE_TYPE_VALUE);
n1 = setNoiseStyle(n1, NOISE_STYLE_PLAIN);
n1 = setNormalizeFBM(n1, true);
n1 = setNumberOfOctaves(n1, 8);
n1 = setLacunarity(n1, 1.0);
n1 = setExponent(n1, 1.0);

m = displace(m, n1, 0.5);
m = calculateNormals(m);

n2 = noise();

n2 = seedNoise(n2, "BETTY");

n2 = setNoiseType(n2, NOISE_TYPE_PERLIN);
n2 = setNoiseStyle(n2, NOISE_STYLE_RIDGE);
n2 = setNumberOfOctaves(n2, 2);
n2 = setStartFrequency(n2, 4);
n2 = setNormalizeFBM(n2, true);
n2 = setExponent(n2, 5.0);

m = displace(m, n2, 0.5);
m = calculateNormals(m);

n3 = noise();

n3 = setNoiseType(n3, NOISE_TYPE_WHITE);
n3 = setWhiteNoiseScale(n3, 1.0);
n3 = setNumberOfOctaves(n3, 1);

m = displace(m, n3, 0.25);

return m;